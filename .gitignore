# Analysis of Algorithms - Academic Repository
# Specialized .gitignore for multi-language and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace
.vs/

# C/C++ Build Artifacts
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a
*.lib
*.out
bin/
obj/
Debug/
Release/

# Java Build Artifacts
*.class
*.jar
*.war
*.ear

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
